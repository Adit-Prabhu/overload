{
  // Rival tactic service. Not deployed yet: deployment needs Adit's go-ahead (AGENTS.md).
  "name": "overload-rival",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "RIVAL_SESSION", "class_name": "RivalSession" },
      { "name": "BUDGET", "class_name": "BudgetLedger" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RivalSession", "BudgetLedger"] }],
  "vars": {
    // "fixture" is a deterministic local rule, labeled as such in every response.
    // A live provider is chosen with decision D6.
    "PROVIDER": "fixture",
    "MODEL": "unset",
    "DAILY_BUDGET_USD": "1.00",
    "INPUT_USD_PER_M": "0.30",
    "OUTPUT_USD_PER_M": "2.50"
  }
}
